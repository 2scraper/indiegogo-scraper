# indiegogo-scraper — copy to .env and fill in what you need.
#
#   cp .env.example .env
#   python3 env_config.py      # prints what was picked up, WITHOUT secrets
#
# Nothing here is required to run the scraper. Measured 2026-09-17 from a
# datacentre address (Hetzner, Helsinki): a plain local Chromium returned a
# full page of results on 4 of 4 runs with none of these set. They buy
# volume from many addresses, a specific country, and no browser
# infrastructure to run — not basic access.
#
# Precedence, highest first:
#   an explicit flag  ->  an exported environment variable  ->  .env  ->  default
#
# A value still carrying {braces} counts as UNSET, so a copied example is
# never sent to an API as if it were a credential.

# Your 2Captcha API key. Shared across this family of scrapers.
# Used for: solving a Cloudflare Turnstile (TurnstileTaskProxyless), and the
# Fingerprint API behind --fingerprint.
TWOCAPTCHA_KEY=your_2captcha_api_key_here

# 2Captcha Scraping Browser API endpoint, for --cdp-endpoint.
# `country-` picks the exit country; `pid-` is a profile with persistent
# cookies and ONE live connection at a time, so reuse pids rather than
# minting one per run.
#
# Profile credentials expire after about a day, so never paste a working one
# into a file you keep — fetch a fresh endpoint when you need it.
# NOT supported by selenium_scraper.py: chromedriver's debuggerAddress takes
# a bare host:port with nowhere to put a password.
INDIEGOGO_CDP_ENDPOINT=ws://{login}-zone-scraping_browser-country-{cc}-pid-{profileId}:{password}@cb.2captcha.com:9222

# A residential proxy, for --proxy. Credentials go through the driver's own
# fields, never onto a command line.
# selenium_scraper.py cannot authenticate a proxy at all and will strip the
# credentials and warn.
INDIEGOGO_PROXY=http://{user}:{password}@eu.proxy.2captcha.com:2334

# A default --url, if you always scrape the same search.
# Left unset here; the engines default to the site's own project search.
INDIEGOGO_URL=
